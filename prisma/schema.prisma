// Capture Inbox (EPIC 11 TIF-1101 / TIF v0.2 Priority 1): lightweight intake, ahead of a
// normalized Evidence record. Capture-only — no edit endpoint is implemented (TIF v0.2 P1).
model CaptureItem {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  observation  String
  tags         String[]      @default([])
  source       CaptureSource
  status       CaptureStatus @default(inbox)
  businessUnit BusinessUnit?
  mediaUrl     String?
  mediaType    String?
  observedAt   DateTime?
  location     String?
  rightsStatus String?
  transcript   String?

  promotedToEvidenceId String?
  promotedToEvidence   Evidence? @relation(fields: [promotedToEvidenceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Inbound Lead Submission: durable capture for website contact and assessment forms.
// Duplicate awareness is intentionally lightweight: email is the stable key, while
// lastSubmittedAt records repeat submissions without creating unnecessary rows.
model InboundLead {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  company         String?
  role            String?
  source          String?
  landingPage     String?
  payload         Json
  notifiedAt      DateTime?
  lastSubmittedAt DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([source])
  @@index([createdAt])
}

// Content Inventory (TIF v0.2 Priority 2 / EPIC 12 TIF-1201): a flat record of existing
// intellectual property across tko-site, rachel-realestate, and cre-intelligence, captured
// for awareness before producing more content. Not linked into Evidence/Opportunity/Asset
// traceability — that mapping is a separate, future EPIC 12 deliverable.
model ContentInventoryItem {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  location     String // path or route within its repo
  repo         String // tko-site | rachel-realestate | cre-intelligence
  assetType    String // freeform: broader than AssetType (e.g. service_page, guide, proof_asset)
  businessUnit BusinessUnit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repo])
}

// Evidence Registry (TIF-604 / content/proof/*/evidence.yaml pattern, DB-backed).
// proofRef is a citation, not a foreign key — it may point at a code/migration ref,
// a screenshot, or an existing content/proof/*/evidence.yaml record id, per
// asset-production/METHOD.md §3's evidence rule.
model Evidence {
  id           String       @id @default(cuid())
  slug         String       @unique
  domain       String // healthcare | rachelos | cre | tko
  businessUnit BusinessUnit
  observation  String
  proofRef     String
  claimGuard   String

  capturedFrom  CaptureItem[]
  opportunities AssetOpportunityEvidence[]
  assets        AssetEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Asset Opportunity Registry (EPIC 11 TIF-1103).
model AssetOpportunity {
  id           String                @id @default(cuid())
  slug         String                @unique
  title        String
  tenant       ContentTenant         @default(tko)
  businessUnit BusinessUnit
  assetType    AssetType
  angle        String
  audience     String?
  sourceType   OpportunitySourceType @default(title_idea)
  sourceUrl    String?
  contextNotes String?
  status       String                @default("opportunity") // opportunity -> composed

  evidenceLinks AssetOpportunityEvidence[]
  assets        Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetOpportunityEvidence {
  opportunityId String
  opportunity   AssetOpportunity @relation(fields: [opportunityId], references: [id])
  evidenceId    String
  evidence      Evidence         @relation(fields: [evidenceId], references: [id])

  @@id([opportunityId, evidenceId])
}

// Asset Composer output (TIF-701..706, template-fill only — no AI/workflow engine).
model Asset {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  title                String
  tenant               ContentTenant @default(tko)
  assetType            AssetType
  status               AssetStatus   @default(draft)
  businessUnit         BusinessUnit
  outputPath           String
  generatedAt          DateTime?
  generatedHash        String?
  currentVersionNumber Int           @default(0)

  opportunityId String?
  opportunity   AssetOpportunity? @relation(fields: [opportunityId], references: [id])

  evidenceLinks    AssetEvidence[]
  versions         AssetVersion[]
  revisionRequests RevisionRequest[]
  derivativeAssets DerivativeAsset[]
  knowledgeDiagram KnowledgeDiagram?
  diagramLinks     AssetDiagram[]    @relation("ConsumerAssetDiagrams")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// KnowledgeDiagram is a typed extension of the existing Asset lifecycle. The parent Asset
// continues to own draft/review/approved/published status, versions, revisions, evidence
// traceability, and derivatives. This model only holds diagram-specific operating metadata.
model KnowledgeDiagram {
  id                String                 @id @default(cuid())
  knowledgeId       String                 @unique // KD-001, KD-002, … permanent citation ID
  assetId           String                 @unique
  asset             Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  diagramFormat     KnowledgeDiagramFormat
  purpose           String
  executiveAudience String[]               @default([])
  businessProblem   String
  inputs            Json
  outputs           Json
  claimBoundary     String
  evidenceStatus    ClaimStatus            @default(experience_based)
  diagramLinks      AssetDiagram[]
  createdBy         String                 @default("operator")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([diagramFormat])
  @@index([evidenceStatus])
}

// A Guide, Assessment, Proposal, Operator Note, or other Asset references one or more
// Knowledge Diagrams through this explicit join. Diagram evidence stays on its parent Asset
// through the existing AssetEvidence relation; no parallel evidence store is created.
model AssetDiagram {
  assetId   String
  asset     Asset            @relation("ConsumerAssetDiagrams", fields: [assetId], references: [id], onDelete: Cascade)
  diagramId String
  diagram   KnowledgeDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@id([assetId, diagramId])
  @@index([diagramId])
}

model AssetVersion {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id])
  versionNumber Int
  title         String
  body          String
  revisionNotes String?
  createdBy     String   @default("operator")
  createdAt     DateTime @default(now())

  @@unique([assetId, versionNumber])
  @@index([assetId, createdAt])
}

model RevisionRequest {
  id            String                @id @default(cuid())
  assetId       String
  asset         Asset                 @relation(fields: [assetId], references: [id])
  versionNumber Int?
  notes         String
  status        RevisionRequestStatus @default(open)
  requestedBy   String?
  createdAt     DateTime              @default(now())
  appliedAt     DateTime?

  @@index([assetId, status])
}

model DerivativeAsset {
  id                  String              @id @default(cuid())
  assetId             String
  asset               Asset               @relation(fields: [assetId], references: [id])
  type                DerivativeAssetType
  body                String
  context             Json?
  behavioralStrategy  Json?
  sourceVersionNumber Int?
  createdAt           DateTime            @default(now())

  @@index([assetId, type])
}

// Traceability (mandatory): every Asset cites the Evidence it was composed from,
// and every Evidence record can resolve its derived Assets via the same join table.
model AssetEvidence {
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id])

  @@id([assetId, evidenceId])
}

model OiOrganization {
  id      String             @id @default(cuid())
  name    String             @unique
  website String?
  kind    OiOrganizationKind
  notes   String?
  domain  String?
  sizeBand String?
  tier    Int                @default(2)
  isWatched Boolean          @default(false)
  aliases String[]           @default([])
  headquarters String?

  people        OiPerson[]
  pursuits      OiPursuit[]
  opportunities OiOpportunity[]
  sources       OiSource[]
  signals       OiSignal[]
  initiatives   OiInitiative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([domain])
  @@index([isWatched])
}

model OiPerson {
  id                      String      @id @default(cuid())
  name                    String
  title                   String
  seniority               OiSeniority
  publicProfileUrl        String?
  sourceUrl               String?
  sourceLabel             String?
  sourcePublishedAt       DateTime?
  sourceConfidence        Int         @default(0)
  isLookalikeAnchor       Boolean     @default(false)
  domainTags              String[]    @default([])
  budgetAuthority         Int         @default(0)
  hiringAuthority         Int         @default(0)
  transformationRelevance Int         @default(0)
  relationshipStrength    Int         @default(0)
  notes                   String?
  linkedinUrl             String?
  lastVerifiedAt          DateTime?
  doNotContact            Boolean     @default(false)

  organizationId String
  organization   OiOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pursuits       OiPursuit[]
  stakeholders   OiStakeholder[]
  contactPoints  OiContactPoint[]
  facts          OiOpportunityFact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name, title])
  @@index([isLookalikeAnchor])
  @@index([seniority])
  @@index([doNotContact])
}

model OiPursuit {
  id                 String          @id @default(cuid())
  mode               OiPursuitMode
  status             OiPursuitStatus @default(prospect)
  targetMonthlyValue Int             @default(20000)
  problemHypothesis  String
  fitHypothesis      String
  evidenceSummary    String
  nextAction         String
  professionalEmail  String?
  emailSource        String?
  emailVerifiedAt    DateTime?
  doNotContact       Boolean         @default(false)
  score              Int
  scoreBreakdown     Json
  scorePolicyVersion String          @default("oi-v1")
  scoredAt           DateTime        @default(now())
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?

  personId       String
  person         OiPerson       @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationId String
  organization   OiOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    OiOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, score])
  @@index([organizationId])
  @@index([opportunityId])
  @@index([nextFollowUpAt])
}

// A possible funded need, role, engagement, advisory opening, or transformation problem.
// Unlike OiPursuit, an opportunity does not require a known person.
model OiOpportunity {
  id             String              @id @default(cuid())
  title          String
  status         OiOpportunityStatus @default(reviewing)
  operatorThesis String?
  thesisBasis    OiFactBasis?
  type           OiOpportunityType

  organizationId String
  organization   OiOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiativeId   String?
  initiative     OiInitiative?    @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  offerId        String?
  offer          OiOffer?         @relation(fields: [offerId], references: [id])
  playbookId     String?
  playbook       OiPlaybook?      @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  estimatedValueLow     Int?
  estimatedValueHigh    Int?
  conversionProbability Int?
  estimatedHours        Decimal? @db.Decimal(6, 2)
  valueBasis            String?
  valueApprovedAt       DateTime?
  disqualifiedReason    String?
  closedReason          String?
  lastActivityAt        DateTime?
  firstSignalAt         DateTime?

  sources      OiSource[]
  sourceLinks  OiOpportunitySource[]
  facts        OiOpportunityFact[]
  evidence     OiEvidence[]
  researchGaps OiResearchGap[]
  scoreHistory OiScore[] @relation("OiScoreHistory")
  pursuits     OiPursuit[]
  stakeholders OiStakeholder[]
  nextActions  OiNextAction[]
  activities   OiActivity[]
  roleProfile  OiRoleProfile?
  outcome      OiOutcome?
  proofLinks   OiOpportunityProof[]
  decisions    OiDecision[]
  campaignLinks OiCampaignOpportunity[]
  artifacts    OiArtifact[]

  currentScoreId String?             @unique
  currentScore   OiScore? @relation("OiCurrentScore", fields: [currentScoreId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([type, status])
  @@index([initiativeId])
  @@index([playbookId])
  @@index([lastActivityAt])
  @@index([createdAt])
}

// Immutable source snapshot. Evidence offsets always point into rawContent.
model OiSource {
  id                String       @id @default(cuid())
  sourceType        OiSourceType
  canonicalUrl      String?
  rawContent        String       @db.Text
  normalizedContent String       @db.Text
  contentHash       String
  retrievedAt       DateTime
  publishedAt       DateTime?

  organizationId String
  organization   OiOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String?
  opportunity    OiOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  evidence       OiEvidence[]
  signals        OiSignal[]
  opportunityLinks OiOpportunitySource[]

  createdAt DateTime @default(now())

  @@unique([organizationId, contentHash])
  @@unique([canonicalUrl, contentHash])
  @@index([canonicalUrl])
  @@index([opportunityId, retrievedAt])
  @@index([retrievedAt])
}

model OiEvidence {
  id          String @id @default(cuid())
  startOffset Int
  endOffset   Int
  excerpt     String @db.Text

  opportunityId String?
  opportunity   OiOpportunity?      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  initiativeId  String?
  initiative    OiInitiative?       @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  sourceId      String
  source        OiSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  facts         OiOpportunityFact[]

  createdAt DateTime @default(now())

  @@unique([sourceId, startOffset, endOffset])
  @@index([opportunityId])
  @@index([initiativeId])
}

model OiOpportunityFact {
  id                 String      @id @default(cuid())
  field              String
  value              String      @db.Text
  normalizedValue    String      @db.Text
  ordinal            Int         @default(0)
  basis              OiFactBasis
  confidence         Int
  isOperatorOverride Boolean     @default(false)
  aiGenerated        Boolean     @default(false)
  aiModel            String?
  promptVersion      String?

  opportunityId String?
  opportunity   OiOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  initiativeId  String?
  initiative    OiInitiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  personId      String?
  person        OiPerson?      @relation(fields: [personId], references: [id], onDelete: Cascade)
  evidenceId    String?
  evidence      OiEvidence?   @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, field, normalizedValue, basis])
  @@index([opportunityId, field, ordinal])
  @@index([initiativeId, field, ordinal])
  @@index([personId, field, ordinal])
  @@index([evidenceId])
}

model OiResearchGap {
  id            String              @id @default(cuid())
  gapKey        String
  question      String              @db.Text
  reason        String              @db.Text
  status        OiResearchGapStatus @default(open)
  resolution    String?             @db.Text
  operatorNotes String?             @db.Text
  resolvedAt    DateTime?
  priority      Int                 @default(2)
  blocksOutreach Boolean            @default(false)
  suggestedSources String[]         @default([])

  opportunityId String?
  opportunity   OiOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  initiativeId  String?
  initiative    OiInitiative?  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, gapKey])
  @@index([status, createdAt])
  @@index([initiativeId, status])
  @@index([blocksOutreach, status])
}

// Append-only opportunity-fit score snapshot. currentScoreId is updated to point here.
model OiScore {
  id                       String @id @default(cuid())
  total                    Int
  completeness             Int
  components               Json
  inputSnapshot            Json
  scorePolicyVersion       String
  capabilityProfileVersion String

  fitScore      Int
  evidenceScore Int
  accessScore   Int
  urgencyScore  Int

  estimatedValue        Int?
  conversionProbability Int?
  expectedValue         Int?
  estimatedHours        Decimal? @db.Decimal(6, 2)
  priorityEfficiency    Decimal? @db.Decimal(12, 2)

  isDisqualified     Boolean  @default(false)
  disqualifyingRules String[] @default([])

  opportunityId String
  opportunity   OiOpportunity  @relation("OiScoreHistory", fields: [opportunityId], references: [id], onDelete: Cascade)
  currentFor    OiOpportunity? @relation("OiCurrentScore")
  decisions     OiDecision[]

  createdAt DateTime @default(now())

  @@index([opportunityId, createdAt])
  @@index([total])
  @@index([priorityEfficiency])
  @@map("OiOpportunityScore")
}

model OiSignal {
  id         String         @id @default(cuid())
  tier       OiSignalTier
  signalType OiSignalType
  status     OiSignalStatus @default(captured)

  summary    String   @db.Text
  occurredAt DateTime?
  confidence Int      @default(50)
  domainTags String[] @default([])

  dismissedReason String?
  dismissedAt     DateTime?

  sourceId       String
  source         OiSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  organizationId String
  organization   OiOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  initiativeLinks OiInitiativeSignal[]
  decisions       OiDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, tier, status])
  @@index([status, createdAt])
  @@index([occurredAt])
}

model OiInitiative {
  id       String             @id @default(cuid())
  name     String
  status   OiInitiativeStatus @default(hypothesized)
  category OiInitiativeCategory

  hypothesis      String      @db.Text
  hypothesisBasis OiFactBasis @default(inferred)
  confidence      Int         @default(45)
  domainTags      String[]    @default([])

  likelyOwnerRoles String[] @default([])

  estimatedStartAt DateTime?
  urgencyBasis     String?
  lastEvidenceAt   DateTime?

  approvedAt DateTime?
  approvedBy String?

  aiGenerated   Boolean @default(false)
  aiModel       String?
  promptVersion String?

  organizationId String
  organization   OiOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  signalLinks   OiInitiativeSignal[]
  opportunities OiOpportunity[]
  facts         OiOpportunityFact[]
  evidence      OiEvidence[]
  researchGaps  OiResearchGap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([status, confidence])
  @@index([category])
  @@index([lastEvidenceAt])
}

model OiInitiativeSignal {
  initiativeId String
  initiative   OiInitiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  signalId     String
  signal       OiSignal     @relation(fields: [signalId], references: [id], onDelete: Cascade)

  contribution String?
  weight       Int    @default(1)
  addedBy      String @default("system")

  createdAt DateTime @default(now())

  @@id([initiativeId, signalId])
  @@index([signalId])
}

model OiOpportunitySource {
  opportunityId String
  opportunity   OiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sourceId      String
  source        OiSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([opportunityId, sourceId])
  @@index([sourceId])
}

model OiStakeholder {
  id        String            @id @default(cuid())
  role      OiStakeholderRole @default(unknown)
  authority OiAuthorityLevel  @default(unknown)

  relationshipType  OiRelationshipType @default(cold)
  warmPathNotes     String?            @db.Text
  referralSourceName String?

  likelyMotivation String? @db.Text
  likelyObjection  String? @db.Text
  relevanceToTodd  String? @db.Text

  roleEvidenceUrl   String?
  roleEvidenceLabel String?
  roleConfidence    Int       @default(50)
  roleVerifiedAt    DateTime?

  accessScore Int?
  isSelected  Boolean   @default(false)
  selectedAt  DateTime?

  opportunityId String
  opportunity   OiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  personId      String
  person        OiPerson      @relation(fields: [personId], references: [id], onDelete: Cascade)

  activities OiActivity[]
  artifacts  OiArtifact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, personId])
  @@index([opportunityId, isSelected])
  @@index([personId])
  @@index([role])
  // Partial unique raw-SQL index lands in POIS-006D:
  // one selected stakeholder per opportunity where isSelected is true.
}

model OiContactPoint {
  id         String              @id @default(cuid())
  type       OiContactPointType
  value      String
  provenance OiContactProvenance
  status     OiContactStatus     @default(active)

  sourceLabel String?
  verifiedAt  DateTime?
  lastUsedAt  DateTime?

  personId String
  person   OiPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, type, value])
  @@index([personId, status])
}

model OiNextAction {
  id     String             @id @default(cuid())
  type   OiNextActionType
  status OiNextActionStatus @default(open)

  description      String    @db.Text
  rationale        String?   @db.Text
  estimatedMinutes Int       @default(15)
  dueAt            DateTime?
  snoozedUntil     DateTime?

  completedAt   DateTime?
  completedNote String?   @db.Text

  isSystemGenerated Boolean @default(true)

  opportunityId String
  opportunity   OiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
  @@index([opportunityId, status])
  // Partial unique raw-SQL index lands in POIS-006D:
  // exactly one open next action per opportunity.
}

model OiActivity {
  id         String              @id @default(cuid())
  type       OiActivityType
  occurredAt DateTime
  summary    String              @db.Text
  sentiment  OiActivitySentiment @default(unknown)

  channel     OiOutreachChannel?
  externalRef String?
  outcomeNote String?            @db.Text

  fromStatus String?
  toStatus   String?
  reason     String? @db.Text

  correctsActivityId String?

  opportunityId String
  opportunity   OiOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stakeholderId String?
  stakeholder   OiStakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)
  artifactId    String?
  artifact      OiArtifact?    @relation(fields: [artifactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([opportunityId, occurredAt])
  @@index([type, occurredAt])
  @@index([stakeholderId])
  @@index([artifactId])
}

model OiRoleProfile {
  id String @id @default(cuid())

  compMin           Int?
  compMax           Int?
  compCurrency      String  @default("USD")
  compSource        String?
  meetsCompFloor    Boolean @default(false)
  totalCompEstimate Int?

  isRemote         Boolean?
  location         String?
  travelPercent    Int?
  remoteCompatible Boolean @default(true)

  reportsToTitle String?
  teamSize       String?
  scopeNotes     String? @db.Text
  seniorityBand  String?

  applicationUrl       String?
  requisitionId        String?
  postedAt             DateTime?
  closesAt             DateTime?
  postingLastCheckedAt DateTime?
  postingIsOpen        Boolean   @default(true)

  resumeVariant   String?
  applicationNote String? @db.Text
  appliedAt       DateTime?

  currentStage    String?
  nextInterviewAt DateTime?
  offerAmount     Int?
  offerReceivedAt DateTime?

  opportunityId String        @unique
  opportunity   OiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetsCompFloor])
  @@index([closesAt])
}

model OiOutcome {
  id   String        @id @default(cuid())
  type OiOutcomeType

  proposedValue  Int?
  actualValue    Int?
  isRecurring    Boolean   @default(false)
  monthlyValue   Int?
  contractStartAt DateTime?
  contractEndAt   DateTime?

  closeReason String  @db.Text
  lesson      String? @db.Text

  daysFromFirstSignal   Int?
  daysFromFirstOutreach Int?
  originatingSignalType OiSignalType?
  scorePolicyVersion    String?
  scoreAtClose          Int?

  opportunityId String        @unique
  opportunity   OiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model OiOffer {
  id   String      @id @default(cuid())
  slug String      @unique
  name String
  kind OiOfferKind

  description  String   @db.Text
  valueLow     Int
  valueHigh    Int
  isRecurring  Boolean  @default(false)
  typicalWeeks Int?
  domainTags   String[] @default([])
  problemTags  String[] @default([])
  publicUrl    String?
  isActive     Boolean  @default(true)
  idealBuyer        String?  @db.Text
  problemSolved     String?  @db.Text
  deliverables      String[] @default([])
  typicalObjections String[] @default([])
  proofItemIds      String[] @default([])
  positioningNotes  String?  @db.Text

  opportunities OiOpportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
}

model OiProofItem {
  id   String @id @default(cuid())
  slug String @unique
  title String
  kind  String

  summary     String   @db.Text
  publicUrl   String?
  internalRef String?
  domainTags  String[] @default([])
  problemTags String[] @default([])
  isApprovedForOutreach Boolean @default(false)

  opportunityLinks OiOpportunityProof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isApprovedForOutreach])
}

model OiOpportunityProof {
  opportunityId String
  opportunity   OiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  proofItemId   String
  proofItem     OiProofItem   @relation(fields: [proofItemId], references: [id], onDelete: Cascade)

  matchScore      Int?
  relevanceReason String?
  isSelected      Boolean @default(false)

  createdAt DateTime @default(now())

  @@id([opportunityId, proofItemId])
  @@index([proofItemId])
}

model OiDecision {
  id   String         @id @default(cuid())
  type OiDecisionType

  decision   String                 @db.Text
  reason     String                 @db.Text
  confidence OiDecisionConfidence

  expectedValue       Int?
  expectedEffortHours Decimal? @db.Decimal(6, 2)
  expectedProbability Int?
  expectedOutcome     String?  @db.Text

  scoreIdAtDecision String?
  scoreId           OiScore? @relation(fields: [scoreIdAtDecision], references: [id], onDelete: SetNull)

  actualOutcome     String?  @db.Text
  actualValue       Int?
  actualEffortHours Decimal? @db.Decimal(6, 2)
  lessonsLearned    String?  @db.Text
  resolvedAt        DateTime?

  valueDelta  Int?
  effortDelta Decimal? @db.Decimal(6, 2)
  wasCorrect  Boolean?

  opportunityId String?
  opportunity   OiOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  signalId      String?
  signal        OiSignal?      @relation(fields: [signalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, createdAt])
  @@index([opportunityId, createdAt])
  @@index([resolvedAt])
}

model OiCampaign {
  id   String @id @default(cuid())
  slug String @unique
  name String

  thesis     String   @db.Text
  domainTags String[] @default([])
  isActive   Boolean  @default(true)

  targetAccountNames String[] @default([])

  opportunityLinks OiCampaignOpportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model OiCampaignOpportunity {
  campaignId    String
  campaign      OiCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   OiOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  addedBy   String   @default("operator")
  createdAt DateTime @default(now())

  @@id([campaignId, opportunityId])
  @@index([opportunityId])
}

model OiPlaybook {
  id    String          @id @default(cuid())
  slug  String          @unique
  name  String
  scope OiPlaybookScope

  appliesToTypes         OiOpportunityType[]  @default([])
  appliesToRelationships OiRelationshipType[] @default([])
  domainTags             String[]             @default([])

  researchSteps      String[] @default([])
  decisionPoints     String[] @default([])
  proofGuidance      String?  @db.Text
  offerGuidance      String?  @db.Text
  draftGuidance      String?  @db.Text
  followUpRhythmDays Int[]    @default([])
  commonObjections   String[] @default([])

  isActive Boolean @default(true)

  opportunities OiOpportunity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, isActive])
}

model OiArtifact {
  id      String           @id @default(cuid())
  kind    OiArtifactKind
  status  OiArtifactStatus @default(draft)
  version Int              @default(1)

  title String?
  body  String @db.Text

  aiGenerated      Boolean  @default(false)
  aiModel          String?
  promptVersion    String?
  contextSnapshot  Json
  citedEvidenceIds String[] @default([])
  citedProofIds    String[] @default([])

  unsupportedClaims String[] @default([])
  validationPassed  Boolean  @default(false)

  approvedAt       DateTime?
  operatorEditedAt DateTime?

  opportunityId String
  opportunity   OiOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  stakeholderId String?
  stakeholder   OiStakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)

  activities OiActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId, kind, status])
  @@unique([opportunityId, kind, stakeholderId, version])
}

model OiWeeklyReview {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime

  metrics Json

  whatChanged      String? @db.Text
  whatStalled      String? @db.Text
  wrongPredictions String? @db.Text
  timeSpentNotes   String? @db.Text
  lessons          String? @db.Text
  nextWeekFocus    String? @db.Text

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodStart, periodEnd])
  @@index([completedAt])
}
